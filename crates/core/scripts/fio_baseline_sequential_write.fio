; log-archive sequential write baseline for storage qualification
; environment variables are provided by run_fio_baseline.sh

[global]
name=log_archive_fio_baseline
ioengine=${IOENGINE}
thread=1
group_reporting=1
time_based=1
runtime=${RUNTIME_SEC}
ramp_time=${RAMP_TIME_SEC}
directory=${TARGET_DIR}
filename=fio-baseline.dat
rw=write
bs=${BLOCK_SIZE}
iodepth=${IODEPTH}
numjobs=${NUMJOBS}
size=${FILE_SIZE}
direct=${DIRECT_IO}
fsync_on_close=1
invalidate=1
norandommap=1
randrepeat=0
end_fsync=1

[sequential_write]
